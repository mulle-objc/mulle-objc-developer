# ObjC library
--nodetype '${MULLE_OBJC_NODETYPE:-tar}' --marks no-singlephase --branch '${MULLE_OBJC_BRANCH}' --tag '${MULLE_OBJC_TAG:-latest}' --url '${MULLE_OBJC_URL:-https://github.com/mulle-objc/MulleObjC/archive/${MULLE_TAG}.tar.gz}' 'MulleObjC'
# mulle-objc-tools is used to produce objc-deps.inc. But an executable that
# does a static link, may not be able to run this (musl-mulle-clang)
--nodetype '${MULLE_OBJC_TOOLS_NODETYPE:-tar}' --marks 'no-all-load,no-bequeath,no-cmake-inherit,no-header,no-link' --url '${MULLE_OBJC_TOOLS_URL:-https://github.com/mulle-objc/mulle-objc-tools/archive/${MULLE_TAG}.tar.gz}' --branch '${MULLE_OBJC_TOOLS_BRANCH}' --tag '${MULLE_OBJC_TOOLS_TAG:-latest}' 'mulle-objc-tools'

